# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vanix?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=vanix_super_secret_jwt_key_change_in_production_123!
JWT_REFRESH_SECRET=vanix_super_secret_refresh_jwt_key_change_in_production_321!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=google_client_id_placeholder

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Settings
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=rzp_test_your_key_secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS S3 / Cloudflare R2 Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET_NAME=vanix-videos

# CloudFront Configuration (optional)
CLOUDFRONT_DOMAIN=https://your-distribution.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=your_key_pair_id
CLOUDFRONT_PRIVATE_KEY_PATH=/path/to/private_key.pem

# Transcoding Paths
TEMP_VIDEO_PATH=/tmp/vanix_videos
