# 🌌 VANIX OTT Platform - Production Environment Variables Template
#
# IMPORTANT: Never commit this file with real credentials to your Git repository.
# Use this file to copy to your production server as `.env` or inject these variables
# directly into your Cloud provider (AWS ECS, Render, Kubernetes Secrets, etc.).

# ------------------------------------------------------------------------------
# 📡 Server Settings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 🗄️ Database Settings
# ------------------------------------------------------------------------------
# Replace <username>, <password>, and <cluster-url> with your live MongoDB Atlas details.
# Make sure your database name is appended at the end (e.g., /vanix_prod)
MONGO_URI=mongodb+srv://db_admin:strongPasswordHere@cluster0.mongodb.net/vanix_prod?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 🔐 JWT Authentication Tokens
# ------------------------------------------------------------------------------
# Generate strong, random 256-bit keys for production.
# Tip: Run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` to generate keys.
JWT_SECRET=generate_and_paste_a_secure_random_hex_key_here_32_chars
JWT_REFRESH_SECRET=generate_and_paste_another_secure_random_hex_key_here_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# ☁️ Cloudinary Storage (Optional - fallback metadata images)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_live_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_live_cloudinary_api_key
CLOUDINARY_API_SECRET=your_live_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 💳 Payments (Razorpay or Stripe)
# ------------------------------------------------------------------------------
# Enters live mode when live keys are populated.
# Enters live mode when live keys are populated. 
# Make sure to configure the live payment webhook in your Razorpay Dashboard pointing to:
# https://your-api-domain.com/api/verify-payment
RAZORPAY_KEY_ID=rzp_live_your_live_key_id
RAZORPAY_KEY_SECRET=rzp_live_your_live_key_secret

# ------------------------------------------------------------------------------
# ⚡ Redis Configuration (BullMQ Queue)
# ------------------------------------------------------------------------------
# Point to your production Redis instance (ElastiCache, RedisLabs, or internal VPS Redis).
REDIS_HOST=your-redis-production-endpoint-or-ip
REDIS_PORT=6379
# If your Redis instance requires password authentication (highly recommended in production):
# REDIS_PASSWORD=your_secure_redis_password

# ------------------------------------------------------------------------------
# 📦 AWS S3 / Cloudflare R2 Configuration (Video Files Host)
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_production_aws_access_key
AWS_SECRET_ACCESS_KEY=your_production_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=vanix-production-videos

# Optional: If you are using Cloudflare R2 instead of AWS S3, uncomment and configure:
# S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# forcePathStyle=true

# ------------------------------------------------------------------------------
# 🔒 CloudFront CDN & Signed URL Configurations (Piracy Protection)
# ------------------------------------------------------------------------------
# Point this to your custom domain CloudFront distribution (e.g., https://media.vanix.com)
CLOUDFRONT_DOMAIN=https://media.vanix.com
# The Key Pair ID generated on the AWS Console under Account Settings -> CloudFront Key Pairs
CLOUDFRONT_KEY_PAIR_ID=K3EXAMPLEKEYPAIR
# Absolute path to your private key (.pem file) downloaded from AWS console, stored securely on the server
# Ensure the user running the node process has read-only permission (chmod 400 private_key.pem)
CLOUDFRONT_PRIVATE_KEY_PATH=/etc/vanix/secrets/cloudfront-private-key.pem

# ------------------------------------------------------------------------------
# 📁 Transcoding Paths
# ------------------------------------------------------------------------------
# Temporary path for storing incoming videos before they are chunked and uploaded to S3.
# Ensure this folder resides on a volume with sufficient free space (e.g. 50GB+ depending on ingest frequency).
TEMP_VIDEO_PATH=/var/vanix/temp_uploads
